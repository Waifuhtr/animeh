<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up. The only thing worth restoring is the session, and
     a refresh token copied onto another device is a session handed over. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
