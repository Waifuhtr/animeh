<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Playback keeps the CPU awake while the screen is off during audio-only
         use; without it the system suspends the decoder mid-episode. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".AnimehApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Animeh"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Animeh">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Watch-party invite links, as the site hands them over.

                The custom scheme is what the /oda/{code} page's button opens,
                and what a notification tap carries. It needs no setup at all,
                which is why it is here — but a chat app will not make it
                tappable, so it is never what somebody actually receives.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="animeh" android:host="oda" />
            </intent-filter>

            <!--
                The same link as an https address, which is what is shared.

                Android 12 stopped offering a chooser for a web link an app
                cannot prove is its own: it goes to the browser, silently. That
                is why an invite used to land on a web page instead of here.
                autoVerify is the claim; the proof is the assetlinks.json the
                plugin serves once this build's signing fingerprint has been
                pasted into Animeh → Entegrasyonlar. Without that the filter is
                inert rather than harmful — the browser page still has its
                button — and with it the link never reaches a browser at all.

                The host is a build-time placeholder because a filter cannot
                name a host that is chosen at runtime; see app/build.gradle.kts.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${roomLinkHost}" android:pathPrefix="/oda/" />
                <data android:scheme="http" android:host="${roomLinkHost}" android:pathPrefix="/oda/" />
            </intent-filter>
        </activity>

        <!--
            Invitations arriving while the app is closed. Firebase's own
            manifest declares the rest of what messaging needs; this is the
            one piece that has to name a class in this app.
        -->
        <service
            android:name=".social.AnimehMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Its own activity so rotation, immersive mode and the back stack
             are the player's business and not the whole app's. -->
        <activity
            android:name=".player.ui.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Animeh.Player" />

        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>
</manifest>
