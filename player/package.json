    "preview": "vite preview"
  },
  "dependencies": {
    "hls.js": "^1.7.1",
    "jassub": "^2.5.14"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "@types/node": "^22.0.0"
  }
}
