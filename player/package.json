{
  "name": "@animeh/player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Animeh custom video player — HLS + MKV + ASS subtitles, built for weak mobile networks",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "npm run prepare:jassub && vite",
    "build": "npm run prepare:jassub && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "preview": "vite preview",
    "prepare:jassub": "node scripts/bundle-jassub.mjs",
    "e2e": "node e2e/playback.mjs",
    "shots": "node e2e/screenshots.mjs"
  },
  "dependencies": {
    "hls.js": "^1.7.1",
    "jassub": "^2.5.14"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
