{
  "name": "@animeh/player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Animeh custom video player — HLS + MKV + ASS subtitles, built for weak mobile networks",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
